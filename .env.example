# copy to .env and edit. .env is gitignored; this file is the documented template.

# provider selection: "local" (ollama) or "bedrock" (aws)
LLM_PROVIDER=local
EMBEDDING_PROVIDER=local

# --- local (ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- cloud (bedrock) ---
# claude models need an inference-profile id (eu. / us. prefix)
AWS_REGION=eu-west-3
BEDROCK_LLM_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# --- pipeline knobs ---
# note: MIN_SCORE in rag.py is embedding-model-specific; retune when changing embedder.
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
